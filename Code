n = int(input("Enter Number"))

for i in range (1,n+1):
    for j in range (n-i):
        print(" ",end="")
    
    for j in range(1,i+1):
        print(chr(64+j),end=" ")
    
    print("")
n=n-1    
for i in range (n,0,-1):
    for j in range (0,n-i+1):
        print(" ",end="")
    
    for j in range(1,i+1):
        print(chr(64+j),end=" ")
    
    print("")
